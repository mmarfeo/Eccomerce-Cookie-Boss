Options -Indexes +FollowSymLinks
DirectoryIndex index.php

# ── Bloquear acceso a archivos sensibles ───────────────────
<IfModule mod_authz_core.c>
    <FilesMatch "\.(env|json|lock|sql|log|md|gitignore)$">
        Require all denied
    </FilesMatch>
</IfModule>

# ── Bloquear acceso a directorios internos ─────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloquear directorios sensibles
    RewriteRule ^app/         - [F,L]
    RewriteRule ^vendor/      - [F,L]
    RewriteRule ^logs/        - [F,L]
    RewriteRule ^tests/       - [F,L]

    # Servir archivos y directorios existentes directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo lo demás va al front controller
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# ── Headers de seguridad ───────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compresión y cache para assets ────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png  "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css   "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
